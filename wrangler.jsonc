{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vclaw-mailclaw",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-15",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "mailclaw-d1",
			"database_id": "a7d6647b-893d-4fa8-a57a-7a78dea92666",
			"remote": true
		}
	],
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "mailclaw-attachments",
			"remote": true
		}
	],
	"workers_dev": true,
	"preview_urls": false,
	"placement": {
		"mode": "smart"
	},
	"assets": {
		"directory": "./dashboard/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	}
}